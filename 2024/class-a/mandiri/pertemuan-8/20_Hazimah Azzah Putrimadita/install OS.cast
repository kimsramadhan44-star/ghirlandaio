[0.003, "o", "\u001b[1;20H\u001b[30m\u001b[103me\u001b[m\u000f for local\u001b[30m\u001b[103me\u001b[m\u000f-g\u001b[30m\u001b[103me\u001b[3;17He\u001b[m\u000fs that ar\u001b[30m\u001b[103me\u001b[m\u000f to b\u001b[30m\u001b[103me\u001b[m\u000f g\u001b[30m\u001b[103me\u001b[m\u000fn\u001b[30m\u001b[103me\u001b[m\u000frat\u001b[30m\u001b[103me\u001b[m\u000fd by th\u001b[30m\u001b[103me\u001b[m\u000f local\u001b[30m\u001b[103me\u001b[m\u000f-g\u001b[30m\u001b[103me\u001b[5;11He\u001b[m\u000f is of th\u001b[30m\u001b[103me\u001b[7;13He\u001b[m\u000f> <chars\u001b[30m\u001b[103me\u001b[9;6He\u001b[m\u000fr\u001b[30m\u001b[103me\u001b[m\u000f <local\u001b[30m\u001b[103me\u001b[m\u000f> is on\u001b[30m\u001b[103me\u001b[m\u000f of th\u001b[30m\u001b[103me\u001b[m\u000f local\u001b[30m\u001b[103me\u001b[m\u000fs giv\u001b[30m\u001b[103me\u001b[m\u000fn in /usr/shar\u001b[30m\u001b[103me\u001b[m\u000f/i18n/local\u001b[30m\u001b[103me\u001b[10;14He\u001b[m\u000ft> is on\u001b[30m\u001b[103me\u001b[m\u000f of th\u001b[30m\u001b[103me\u001b[m\u000f charact\u001b[30m\u001b[103me\u001b[m\u000fr s\u001b[30m\u001b[103me\u001b[m\u000fts list\u001b[30m\u001b[103me\u001b[m\u000fd in /usr/shar\u001b[30m\u001b[103me\u001b[12;6He\u001b[m\u000f local\u001b[30m\u001b[103me\u001b[m\u000f-g\u001b[30m\u001b[103me\u001b[m\u000fn command will g\u001b[30m\u001b[103me\u001b[m\u000fn\u001b[30m\u001b[103me\u001b[m\u000frat\u001b[30m\u001b[103me\u001b[m\u000f all th\u001b[30m\u001b[103me\u001b[m\u000f local\u001b[30m\u001b[103me\u001b[13;14He\u001b[m\u000fm in /usr/lib/local\u001b[30m\u001b[103me\u001b[15;21He\u001b[m\u000fd local\u001b[30m\u001b[103me\u001b[m\u000fs is giv\u001b[30m\u001b[103me\u001b[m\u000fn in /usr/shar\u001b[30m\u001b[103me\u001b[16;17He\u001b[m\u000fd in this fil\u001b[30m\u001b[103me\u001b[m\u000f. Uncomm\u001b[30m\u001b[103me\u001b[m\u000fnt th\u001b[30m\u001b[103me\u001b[m\u000f n\u001b[30m\u001b[103mee\u001b[m\u000fd\u001b[30m\u001b[103me\u001b[m\u000fd local\u001b[30m\u001b[103me\u001b[m\u000fs b\u001b[30m\u001b[103me\u001b[66;225H\u001b[0;10;7m\u000f20\u001b[67;3H\u001b[?25h"]
[0.588, "o", "\u001b[?25l\u001b[m\u000fn"]
[0.003, "o", "\u001b[1;20He for locale-g\u001b[30m\u001b[103men\u001b[3;17H\u001b[m\u000fes that are to be g\u001b[30m\u001b[103men\u001b[m\u000ferated by the locale-g\u001b[30m\u001b[103men\u001b[5;11H\u001b[m\u000fe is of the\u001b[7;13He> <charse\u001b[9;6Here <locale> is one of the locales giv\u001b[30m\u001b[103men\u001b[m\u000f in /usr/share/i18n/locale\u001b[10;14Het> is one of the character sets listed in /usr/share\u001b[12;6He locale-g\u001b[30m\u001b[103men\u001b[m\u000f command will g\u001b[30m\u001b[103men\u001b[m\u000ferate all the locale\u001b[13;14Hem in /usr/lib/locale\u001b[15;21Hed locales is giv\u001b[30m\u001b[103men\u001b[m\u000f in /usr/share\u001b[16;17Hed in this file. Uncomm\u001b[30m\u001b[103men\u001b[m\u000ft the needed locales be\u001b[66;225H\u001b[0;10;7m\u000f34\u001b[67;4H\u001b[?25h"]
