[0.003, "o", "(183/187) installing python-gobject                                                                                                              [########################################################################################] 100%\r\r\n"]
[0.000, "o", "Optional dependencies for python-gobject\r\n\u001b[0;1m   \u001b[0m python-cairo: Cairo bindings\r\n"]
