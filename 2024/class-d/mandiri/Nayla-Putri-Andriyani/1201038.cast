[0.001, "o", "\u001b[?25l\u001b[m\u000f/etc/pam.d/system-login\u001b[K\r\n#%PAM-1.0\u001b[K\r\n\u001b[K\nauth       required   \u001b[92mpam_shells.so\u001b[m\u000f\u001b[K\r\nauth       requisite  \u001b[92mpam_nologin.so\u001b[m\u000f\u001b[K\r\nauth       include    \u001b[92msystem-auth\u001b[m\u000f\u001b[K\r\nauth       required   \u001b[92mpam_mount.so\u001b[m\u000f\u001b[K\r\n\u001b[K\naccount    required   \u001b[92mpam_access.so\u001b[m\u000f\u001b[K\r\naccount    required   \u001b[92mpam_nologin.so\u001b[m\u000f\u001b[K\r\naccount    include    \u001b[92msystem-auth\u001b[m\u000f\u001b[K\r\n\u001b[K\npassword   include    \u001b[92msystem-auth\u001b[m\u000f\u001b[K\r\n\u001b[K\nsession    optional   \u001b[92mpam_loginuid.so\u001b[m\u000f\u001b[K\r\nsession    optional   \u001b[92mpam_keyinit.so\u001b[m\u000f       force revoke\u001b[K\r\nsession    include    \u001b[92msystem-auth\u001b[m\u000f\u001b[K\r\nsession    optional   \u001b[92mpam_lastlog2.so\u001b[m\u000f      silent\u001b[K\r\nsession    optional   \u001b[92mpam_motd.so\u001b[m\u000f\u001b[K\r\nsession    optional   \u001b[92mpam_mail.so\u001b[m\u000f          dir=/var/spool/mail standard quiet\u001b[K\r\nsession    optional   \u001b[92mpam_umask.so\u001b[m\u000f\u001b[K\r\n\u001b[96m-\u001b[m\u000fsession   optional   \u001b[92mpam_systemd.so\u001b[m\u000f\u001b[K\r\nsession    required   \u001b[92mpam_env.so\u001b[m\u000f\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n\u001b[0;10;7m\u000f/etc/pam.d/system-login                                                                                                                                 1,1            All\u001b[m\u000f\r\n\u001b[J\u001b[2 q\u001b[2 q\u001b[H/etc/pam.d/system-login\u