[0.004, "o", "\u001b[1;65r\u001b[H\u001b[35M\u001b[1;67r\u001b[7;39H\u001b[30m\u001b[103msig\u001b[8;60Hg\u001b[13;56H\u001b[m\u000fsi\u001b[20;30Hsi\u001b[22;11Hsi\u001b[23;46Hsi\u001b[27;7Hsi\r\n\n\n\n#\u001b[K\r\n# The header [repo-name] is crucial - it must be present and\u001b[K\r\n# uncommented to enable the repo.\u001b[K\r\n#\u001b[K\r\n\u001b[K\n# The testing repositories are disabled by default. To enable, uncomment the\u001b[K\r\n# repo name header and Include lines. You can add preferred servers immediately\u001b[K\r\n# after the header, and they will be used before the default mirrors.\u001b[K\r\n\u001b[K\n#[core-testing]\u001b[K\r\n#Include = /etc/pacman.d/mirrorlist\u001b[K\r\n\u001b[K\n[core]\u001b[K\r\nInclude = /etc/pacman.d/mirrorlist\u001b[K\r\n\u001b[K\n#[extra-testing]\u001b[K\r\n#Include = /etc/pacman.d/mirrorlist\u001b[K\r\n\u001b[K\n[extra]\u001b[K\r\nInclude = /etc/pacman.d/mirrorlist\u001b[K\r\n\u001b[K\n# If you want to run 32 bit applications on your x86_64 system,\u001b[K\r\n# enable the multilib repositories as required here.\u001b[K\r\n\u001b[K\n#[multilib-testing]\u001b[K\r\n#Include = /etc/pacman.d/mirrorlist\u001b[K\r\n\u001b[K\n#[multilib]\u001b[K\r\n#Include = /etc/pacman.d/mirrorlist\u001b[K\r\n\u001b[K\n# An example of a custom package repository.  See the pacman manpage for\u001b[K\r\n# tips on creating your own repositories.\u001b[K\r\n#[custom]\u001b[K\r\n#SigLevel = Optional TrustAll\u001b[K\r\n#Server = file:///home/custompkgs\u001b[K\u001b[66;224H\u001b[0;10;7m\u000f2,39          Bot\u001b[67;5H\u001b[?25h"]
