[0.001, "o", "Created directory \"/boot/EFI/BOOT\".\r\r\nCreated directory \"/boot/loader\".\r\r\nCreated directory \"/boot/loader/keys\".\r\r\nCreated directory \"/boot/loader\".\r\r\nCreated directory \"/boot/loader/entries\".\r\r\nCreated directory \"/boot/EFI\".\r\r\nCreated directory \"/boot/EFI/Linux\".\r\r\n"]
