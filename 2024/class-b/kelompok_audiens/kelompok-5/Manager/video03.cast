[1.019, "o", "\u001b[?25l\u001b[m\u000f \b"]
[0.003, "o", "\u001b[1;2H# sudoers file.\u001b[61X\u001b[3;4HThis file MUST be edited with the 'visudo' command as root.  \u001b[4;4HFailure to use 'visudo' may result in syntax or file permission errors\u001b[5;4Hthat prevent sudo from running.\u001b[27X\u001b[6;2H#\u001b[22X\n See the sudoers man page for the details on how to write a sudoers file.\u001b[8;3H\u001b[56X\r\n\u001b[67X\u001b[10;3H\u001b[63X\u001b[11;4HHost alias specification\u001b[39X\u001b[12;2H#\u001b[24X\n Groups of machines. These may include host names (optionally with wildcards),\u001b[14;4HIP addresses, network numbers or netgroups.\u001b[28X\u001b[15;3HHost_Alias    WEBSERVERS = www1, www2, www3\r\n  \n\u001b[62X\u001b[18;4HUser alias specification\u001b[44X\u001b[19;3H\u001b[69X\u001b[20;4HGroups of users.  These may consist of user names, uids, Unix groups, \u001b[21;2H# or netgroups.\u001b[5X\u001b[22;3HUser_Alias    ADMINS = millert, dowdy, mikef\r\n\u001b[48X\u001b[24;2H#\u001b[27X\u001b[25;2H# Cmnd alias specification\u001b[27;4HGroups of commands.  Often used to group related commands together.\u001b[28;2H Cmnd_Alias    PROCESSES = /usr/bin/nice, /bin/kill, /usr/bin/renice, \\\u001b[29;2H                           /usr/bin/pkill, /usr/bin/top \u001b[30;2H\u001b[44X\n Cmnd_Alias    REBOOT = /sbin/halt, /sbin/reboot, /sbin/poweroff\u001b[32;2H\u001b[70X\n Cmnd_Alias    DEBUGGERS = /usr/bin/gdb, /usr/bin/lldb, /usr/bin/strace, \\\u001b[34;2H                           /usr/bin/truss, /usr/bin/bpftrace, \\\u001b[35;3H                          /usr/bin/dtrace, /usr/bin/dtruss\u001b[36;2H \u001b[37;2H Cmnd_Alias    PKGMAN = /usr/bin/apt, /usr/bin/dpkg, /usr/bin/rpm, \\\u001b[38;2H                        /usr/bin/yum, /usr/bin/dnf,  /usr/bin/zypper, \\\u001b[39;3H                       /usr/bin/pacman\u001b[42;4HDefaults specification   \r\n\n## Preserve editor environment variables for visudo.\u001b[45;3H To preserve these for all commands, remove the \"!visudo\" qualifier.\r\n\u001b[0;10;1m\u000fDefaults\u001b[m\u000f\u001b[96m!\u001b[m\u000f\u001b[92m/usr/bin/visudo\u001b[m\u000f \u001b[94menv_keep\u001b[m\u000f += \u001b[92m\"SUDO_EDITOR EDITOR VISU\u001b[m\u000f\u001b[30m\u001b[103mAL\u001b[m\u000f\u001b[92m\"\r\n\n\u001b[m\u000f## Use a hard-coded PATH instead of the user's to find commands.\r\n## This also helps prevent poorly written scripts from running\u001b[50;4Harbitrary commands under sudo.\u001b[34X\r\n\u001b[0;10;1m\u000fDefaults\u001b[m\u000f \u001b[94msecure_path\u001b[m\u000f=\u001b[92m\"/usr/local/sbin:/usr/local/bin:/usr/bin\"\r\n\u001b[m\u000f##\u001b[53;4HYou may wish to keep some of the following environment variables\u001b[54;2H# when running commands via sudo.  \r\n##\u001b[56;4HLocale settings\u001b[48X\u001b[57;3HDefaults env_keep += \"LANG LANGUAGE LINGUAS LC_* _XKB_CHARSET\"\r\n##\u001b[59;4HRun X applications through sudo; HOME is used to find the\u001b[8X\u001b[60;4H.Xauthority file.  Note that other programs use HOME to find   \u001b[61;2H# configuration files and this may lead to privilege escalation!\u001b[62;3HDefaults env_keep += \"HOME\"\u001b[54X\r\n##\u001b[64;4HX11 resource path settings\u001b[12X\r\n# Defaults env_keep += \"XAPPLRESDIR XFILESEARCHPATH XUSERFILESEARCHPATH\"\u001b[66;223H\u001b[0;10;7m\u000f46,62          Top\u001b[67;3H\u001b[?25h"]
[0.421, "o", "\u001b[?25l\b\u001b[m\u000fL \b"]
