[0.050, "o", "Optional dependencies for systemd\r\n"]
[0.000, "o", "\u001b[0;1m   \u001b[0m libmicrohttpd: systemd-journal-gatewayd and systemd-journal-remote\r\n    apparmor: additional security features\r\n    quota-tools: kernel-level quota management\r\n    systemd-sysvcompat: symlink package to provide sysvinit binaries [pending]\r\n"]
[0.004, "o", "    systemd-ukify: combine kernel and initrd into a signed Unified Kernel Image\r\n    polkit: allow administration as unprivileged user\r\n    curl: systemd-journal-upload, machinectl pull-tar and pull-raw [installed]\r\n    gnutls: systemd-journal-gatewayd and systemd-journal-remote [installed]\r\n    qrencode: show QR codes\r\n    iptables: firewall features [pending]\r\n    libarchive: convert DDIs to tarballs [installed]\r\n    libbpf: support BPF programs [pending]\r\n    libpwquality: check password quality\r\n    libfido2: unlocking LUKS2 volumes with FIDO2 token\r\n    libp11-kit: support PKCS#11 [installed]\r\n    tpm2-tss: unlocking LUKS2 volumes with TPM2 [pending]\r\n( 95/191) installing mkinitcpio                                                                        [------------------------------------------------------------]   0%\r"]
[0.011, "o", "( 95/191) installing mkinitcpio                                                                        [############################################################] 100%\r\r\n"]
[0.001, "o", "Optional dependencies for mkinitcpio\r\n\u001b[0;1m   \u001b[0m xz: Use lzma or xz compression for the initramfs image [installed]\r\n    bzip2: Use bzip2 compression for the initramfs image [installed]\r\n    lzop: Use lzo compression for the initramfs image\r\n    lz4: Use lz4 compression for the initramfs image [installed]\r\n"]
[0.000, "o", "    mkinitcpio-nfs-utils: Support for root filesystem on NFS\r\n"]
