[0.005, "o", "\u001b[15;8HA\u001b[22;8HAlias    A\u001b[28;8HA\u001b[31;8HA\u001b[33;8HA\u001b[37;8HAlias    PKGMA\u001b[46;62H\u001b[30m\u001b[103mAL\u001b[48;22H\u001b[m\u000fA\u001b[57;26HANG LANGUAGE LINGUAS LC_* _XKB_CHA\u001b[65;26HAPPLRESDIR XFILESEARCHPATH XUSERFILESEARCHPA\u001b[66;223H\u001b[0;10;7m\u000f46,62\u001b[67;4H\u001b[?25h"]
