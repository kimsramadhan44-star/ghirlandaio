[7.574, "o", "sudo passwd nadyanst"]
[1.672, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bsu\u001b[K"]
[0.763, "o", "\r\n\u001b[?2004l\r"]
[0.039, "o", "\r\nWe trust you have received the usual lecture from the local System\r\nAdministrator. It usually boils down to these three things:\r\n\r\n    #1) Respect the privacy of others.\r\n    #2) Think before you type.\r\n    #3) With great power comes great responsibility.\r\n\r\nFor security reasons, the password you type will not be visible.\r\n\r\n[sudo] password for nadyanst: "]
[2.032, "o", "\r\n"]
[1.733, "o", "Sorry, try again.\r\n"]
[0.031, "o", "[sudo] password for nadyanst: "]
[183.995, "o", "\r\n"]
[2.277, "o", "sudo: PAM authentication error: Authentication token manipulation error\r\n"]
[0.001, "o", "sudo: a password is required\r\n"]
[0.002, "o", "\u001b[?2004h[nadyanst@blackbird /]$ "]
[81.400, "o", "sudo su"]
