[0.003, "o", "\u001b[15;8H\u001b[30m\u001b[103mA\u001b[22;8HA\u001b[m\u000flias    \u001b[30m\u001b[103mA\u001b[28;8HA\u001b[31;8HA\u001b[33;8HA\u001b[37;8HA\u001b[m\u000flias    PKGM\u001b[30m\u001b[103mA\u001b[46;62HA\u001b[48;22HA\u001b[57;26HA\u001b[m\u000fNG L\u001b[30m\u001b[103mA\u001b[m\u000fNGU\u001b[30m\u001b[103mA\u001b[m\u000fGE LINGU\u001b[30m\u001b[103mA\u001b[m\u000fS LC_* _XKB_CH\u001b[30m\u001b[103mA\u001b[65;26HA\u001b[m\u000fPPLRESDIR XFILESE\u001b[30m\u001b[103mA\u001b[m\u000fRCHP\u001b[30m\u001b[103mA\u001b[m\u000fTH XUSERFILESE\u001b[30m\u001b[103mA\u001b[m\u000fRCHP\u001b[30m\u001b[103mA\u001b[66;224H\u001b[0;10;7m\u000f7,8\u001b[67;3H\u001b[?25h"]
