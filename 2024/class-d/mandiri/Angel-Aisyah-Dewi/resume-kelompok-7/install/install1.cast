[0.003, "o", "\u001b[1;7H\u001b[30m\u001b[103ms\u001b[m\u000fePkgLi\u001b[30m\u001b[103ms\u001b[m\u000ft\u001b[30m\u001b[103ms\ns\u001b[3;10Hs\u001b[4;4Hs\u001b[m\u000fableSandboxFile\u001b[30m\u001b[103ms\u001b[m\u000fy\u001b[30m\u001b[103ms\u001b[5;4Hs\u001b[m\u000fableSandboxSy\u001b[30m\u001b[103ms\u001b[m\u000fcall\u001b[30m\u001b[103ms\u001b[7;28Hs\u001b[m\u000f package\u001b[30m\u001b[103ms\u001b[m\u000f \u001b[30m\u001b[103ms\u001b[m\u000figned by key\u001b[30m\u001b[103ms\u001b[m\u000f that it\u001b[30m\u001b[103ms\u001b[8;6Hs\u001b[m\u000ft\u001b[30m\u001b[103ms\u001b[m\u000f (\u001b[30m\u001b[103ms\u001b[m\u000fee pacman-key and it\u001b[30m\u001b[103ms\u001b[m\u000f man page), a\u001b[30m\u001b[103ms\u001b[m\u000f well a\u001b[30m\u001b[103ms\u001b[m\u000f un\u001b[30m\u001b[103ms\u001b[m\u000figned package\u001b[30m\u001b[103ms\u001b[9;30Hs\u001b[13;15Hs\u001b[m\u000ft run `pacman-key --init` before fir\u001b[30m\u001b[103ms\u001b[m\u000ft u\u001b[30m\u001b[103ms\u001b[14;45Hs\u001b[15;11Hs\u001b[20;19Hs\u001b[m\u000fearch repo\u001b[30m\u001b[103ms\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[21;15Hs\u001b[m\u000ftom mirror\u001b[30m\u001b[103ms\u001b[m\u000f can be added here or in \u001b[30m\u001b[103ms\u001b[m\u000feparate file\u001b[30m\u001b[103ms\u001b[22;11Hs\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[m\u000f li\u001b[30m\u001b[103ms\u001b[m\u000fted fir\u001b[30m\u001b[103ms\u001b[m\u000ft will take precedence when package\u001b[30m\u001b[103ms\u001b[23;26Hs\u001b[m\u000f, regardle\u001b[30m\u001b[103mss\u001b[m\u000f of ver\u001b[30m\u001b[103ms\u001b[24;10Hs\u001b[25;10Hs\u001b[27;7Hs\u001b[m\u000fitory entrie\u001b[30m\u001b[103ms\u001b[32;27Hs\u001b[m\u000f crucial - it mu\u001b[30m\u001b[103ms\u001b[m\u000ft be pre\u001b[30m\u001b[103ms\u001b[36;9Hs\u001b[m\u000fting repo\u001b[30m\u001b[103ms\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[m\u000f are di\u001b[30m\u001b[103ms\u001b[37;36Hs\u001b[m\u000f. You can add preferred \u001b[30m\u001b[103ms\u001b[m\u000ferver\u001b[30m\u001b[103ms\u001b[38;39Hs\u001b[m\u000fed before the default mirror\u001b[30m\u001b[103ms\u001b[40;10Hs\u001b[41;34Hs\u001b[44;33Hs\u001b[46;11Hs\u001b[47;34Hs\u001b[50;33Hs\u001b[52;40Hs\u001b[m\u000f on your x86_64 \u001b[30m\u001b[103ms\u001b[m\u000fy\u001b[30m\u001b[103ms\u001b[53;27Hs\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[m\u000f a\u001b[30m\u001b[103ms\u001b[55;14Hs\u001b[56;34Hs\u001b[59;34Hs\u001b[61;21Hs\u001b[m\u000ftom package repo\u001b[30m\u001b[103ms\u001b[62;6Hs\u001b[m\u000f on creating your own repo\u001b[30m\u001b[103ms\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[63;5Hs\u001b[64;25Hs\ns\u001b[m\u000ftompkg\u001b[30m\u001b[103ms\u001b[66;227H\u001b[0;10;7m\u000f26\u001b[67;3H\u001b[?25h"]
