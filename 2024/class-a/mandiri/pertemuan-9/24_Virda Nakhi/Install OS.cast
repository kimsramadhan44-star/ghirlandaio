[1.229, "o", "\r\r\n\u001b[0;31mcompleting \u001b[1mfile system option\u001b[m\u000f\u001b[0m\r\n\u001b[0masync          -- do all I/O asynchronously\r\natime          -- update access time\r\nblock          -- specify block size\r\ncheck          -- specify file name conversion\r\ncruft          -- ignore high bits of file length\r\ndefaults       -- use default options\r\ndiratime       -- update directory access time\r\ndirsync        -- perform directory updates synchronously\r\nencryption     -- enable encryption\r\nexec           -- permit execution of binaries\r\n"]
[0.000, "o", "gid            -- specify group ID of all files\r\niocharset      -- character set when converting from 8 bit to unicode (Joliet)\r\nkeybits        -- set number of bits in encryption key\r\nloop           -- use loopback device\r\nmand           -- allow mandatory locks\r\nmap            -- specify non-Rock Ridge name conversion\r\nmode           -- specify permissions\r\nnoatime        -- don't update access time\r\nnodiratime     -- don't update directory access time\r\nnoexec         -- don't allow execution of binaries\r\nnoiversion     -- don't increment i_version inode field\r\nnojoliet       -- disable Microsoft Joliet extensions\r\nnomand         -- don'tallow mandatory locks\r\nnorelatime     -- update access time without regard to mtime/ctime\r\nnorock         -- disable Rock Ridge extensions\r\nnostrictatime  -- default atime update behaviour\r\noffset         -- specify data start for loopback mount\r\nrelatime       -- update atime relative to mtime/ctime\r\nremount        -- mount already mounted file system\r\nsbsector       -- specify starting sector\r\nsession        -- select session number on multisession CD\r\nstrictatime    -- full atime updates\r\nsync           -- do I/O synchronously\r\nuid            -- specify user ID of all files\r\nunhide         -- show hidden and associated files\r\nutf8           -- mount the filesystem in UTF8 mode (Joliet)\r\n"]
