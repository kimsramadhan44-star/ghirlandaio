[0.003, "o", "\u001b[1;65r\u001b[H\u001b[35L\u001b[1;67r\u001b[H#\u001b[K\r\n# /etc/pacman.conf\u001b[K\r\n#\u001b[K\r\n# See the pacman.conf(5) manpage for option and repo\u001b[30m\u001b[103msi\u001b[m\u000ftory directives\u001b[K\r\n\u001b[K\n#\u001b[K\r\n# GENERAL OPTIONS\u001b[K\r\n#\u001b[K\r\n[options]\u001b[K\r\n# The following paths are commented out with their default values listed.\u001b[K\r\n# If you wish to use different paths, uncomment and update the paths.\u001b[K\r\n#RootDir     = /\u001b[K\r\n#DBPath      = /var/lib/pacman/\u001b[K\r\n#CacheDir    = /var/cache/pacman/pkg/\u001b[K\r\n#LogFile     = /var/log/pacman.log\u001b[K\r\n#GPGDir      = /etc/pacman.d/gnupg/\u001b[K\r\n#HookDir     = /etc/pacman.d/hooks/\u001b[K\r\nHoldPkg     = pacman glibc\u001b[K\r\n#XferCommand = /usr/bin/curl -L -C - -f -o %o %u\u001b[K\r\n#XferCommand = /usr/bin/wget --pas\u001b[30m\u001b[103msi\u001b[m\u000fve-ftp -c -O %o %u\u001b[K\r\n#CleanMethod = KeepInstalled\u001b[K\r\nArchitecture = auto\u001b[K\r\n\u001b[K\n# Pacman won't upgrade packages listed in IgnorePkg and members of IgnoreGroup\u001b[K\r\n#IgnorePkg   =\u001b[K\r\n#IgnoreGroup =\u001b[K\r\n\u001b[K\n#NoUpgrade   =\u001b[K\r\n#NoExtract   =\u001b[K\r\n\u001b[K\n# Misc options\u001b[K\r\n#UseSyslog\u001b[K\r\n#Color\u001b[K\r\n#NoProgressBar\u001b[K\r\nCheckSpace\u001b[K\u001b[36;7HsePkgLists\ns\u001b[38;10Hs\u001b[39;4HsableSandboxFilesys\u001b[40;4HsableSandboxSyscalls\u001b[42;28Hs packages \u001b[30m\u001b[103msi\u001b[m\u000fgned by keys that its\u001b[43;6Hsts (see pacman-key and its man page), as well as un\u001b[30m\u001b[103msi\u001b[m\u000fgned packages\u001b[44;30Hs\u001b[48;15Hst run `pacman-key --init` before first u\u001b[30m\u001b[103msi\u001b[49;45H\u001b[m\u000fs\u001b[50;11Hs\u001b[55;19Hsearch repo\u001b[30m\u001b[103msi\u001b[m\u000ftories\u001b[56;15Hstom mirrors can be added here or in separate files\u001b[57;12H\u001b[30m\u001b[103mi\u001b[m\u000ftories listed first will take precedence when packages\u001b[58;26Hs, regardless of ver\u001b[30m\u001b[103msi\u001b[59;10H\u001b[m\u000fs\u001b[60;10Hs\u001b[62;8H\u001b[30m\u001b[103mi\u001b[m\u000ftory entries\u001b[66;223H\u001b[0;10;7m\u000f4,53           Top\u001b[67;4H\u001b[?25h"]
