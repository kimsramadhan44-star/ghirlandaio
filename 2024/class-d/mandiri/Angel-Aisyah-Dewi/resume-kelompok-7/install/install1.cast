[0.004, "o", "\u001b[?25l\u001b[67;230H  \r\u001b[67;1H/\u001b[HSigLevel    = Required DatabaseOptional\r\nLocalFileSigLevel = Optional\r\n#RemoteFileSigLevel = Required\r\n\u001b[25X\u001b[5;2H NOTE: You must run `pacman-key --init` before first using pacman; the local\r\n# keyring can then be populated with the keys of all official Arch Linux\u001b[7;3Hpackagers with `pacman-key --populate archlinux`.\u001b[24X\r\n\u001b[73X\n#\u001b[38X\r\n# REPOSITORIES\u001b[14X\u001b[11;2H   - can be defined here or included from another file\r\n#   - pacman will search repositories in the order defined here\u001b[13;3H  - local/custom mirrors can be added here or in separate files\u001b[12X\u001b[14;3H  - repositories listed first will take precedence when packages\u001b[6X\u001b[15;3H    have identical names, regardless of version number\r\n#   - URLs will have $repo replaced by the name of the current repo\u001b[17;2H   - URLs will have $arch replaced by the name of the architecture\u001b[18;2H\u001b[13X\u001b[19;3HRepository entries are of the format:\u001b[16X\u001b[20;5H    [repo-name]\u001b[44X\u001b[21;5H    Server = ServerName\u001b[38X\u001b[22;5H    Include = IncludePath\u001b[37X\u001b[23;2H\u001b[55X\u001b[24;3HThe header [repo-name] is crucial - it must be present and\u001b[7X\u001b[25;3Huncommented to enable the repo.\u001b[34X\r\n\n\u001b[39X\u001b[28;3HThe testing repositories are disabled by default. To enable, uncomment the\u001b[29;3Hrepo name header and Include lines. You can add preferred servers immediately\u001b[30;3Hafter the header, and they will be used before the default mirrors.\r\n \n[core-testing]\u001b[45X\u001b[33;2HInclude = /etc/pacman.d/mirrorlist\r\n \r\n[core]\r\nInclude = /etc/pacman.d/mirrorlist\u001b[42X\r\n\u001b[79X\u001b[38;2H[extra-testing]\u001b[53X\r\n#Include = /etc/pacman.d/mirrorlist\r\n\u001b[15X\n[extra]\u001b[28X\r\nInclude = /etc/pacman.d/mirrorlist\r\n\u001b[6X\n# If you want to run 32 bit applications on your x86_64 system,\r\n# enable the multilib repositories as required here.\r\n\u001b[16X\u001b[47;2H[multilib-testing]\u001b[16X\r\n#Include = /etc/pacman.d/mirrorlist\r\n\u001b[7X\n#[multilib]\u001b[23X\r\n#Include = /etc/pacman.d/mirrorlist\r\n\u001b[63X\u001b[53;3HAn example of a custom package repository.  See the pacman manpage for\r\n# tips on creating your own repositories.\u001b[55;3Hcustom]\u001b[10X\u001b[56;2HSigLevel = Optional TrustAll\u001b[6X\r\nrServer = file:///home/custompkgs\r\n\u001b[0;10;4;1m\u000fetc/pacman.conf [+]                                                                                                                                                                                                           100,7          Bot\r\n\u001b[m\u000f/\u001b[34X\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n\u001b[0;10;7m\u000f[Command Line]                                                                                                                                                                                                                1,0-1          All\u001b[2 q\u001b[59;2H\u001b[?25h"]
