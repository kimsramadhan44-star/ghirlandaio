[0.675, "o", "\u001b[?25l\r\u001b[67;1H\u001b[?25h"]
[0.005, "o", "\u001b[?25l   \u001b[H#VerbosePkgLists\u001b[23X\r\nParallelDownloads = 5\u001b[7X\r\nDownloadUser = alpm\u001b[11X\r\n#DisableSandboxFilesystem\u001b[5;2HDisableSandboxSyscalls\u001b[54X\r\n\u001b[72X\u001b[7;3HBy default, pacman accepts packages signed by keys that its local keyring\r\n# trusts (see pacman-key and its man page), as well as unsigned packages.\r\nSigLevel    = Required DatabaseOptional\r\nLocalFileSigLevel = Optional\u001b[11;2HRemoteFileSigLevel = Required\u001b[25X\r\n\u001b[63X\u001b[13;3HNOTE: You must run `pacman-key --init` before first using pacman; the local\u001b[14;3Hkeyring can then be populated with the keys of all official Arch Linux\u001b[15;3Hpackagers with `pacman-key --populate archlinux`.\u001b[5X\r\n\u001b[67X\u001b[17;2H\u001b[66X\n REPOSITORIES\u001b[19;3H  - can be defined here or included from another file\u001b[20;5H- pacman will search repositories in the order defined here\u001b[21;5H- local/custom mirrors can be added here or in separate files\u001b[22;5H- repositories listed first will take precedence when packages\u001b[23;2H     have identical names, regardless of version number\u001b[24;3H  - URLs will have $repo replaced by the name of the current repo\u001b[25;3H  - URLs will have $arch replaced by the name of the architecture\r\n\n# Repository entries are of the format:\u001b[28;3H      [repo-name]\u001b[57X\u001b[29;3H      Server = ServerName\u001b[52X\u001b[30;3H      Include = IncludePath\u001b[40X\r\n#\n The header [repo-name] is crucial - it must be present and\u001b[33;2H uncommented to enable the repo.  \r\n#\r\n\u001b[6X\n# The testing repositories are disabled by default. To enable, uncomment the\r\n# repo name header and Include lines. You can add preferred servers immediately\u001b[38;2H after the header, and they will be used before the default mirrors.\r\n\u001b[35X\n#[core-testing]\r\n#Include = /etc/pacman.d/mirrorlist\r\n\u001b[34X\n[core]\r\nInclude = /etc/pacman.d/mirrorlist\u001b[29X\r\n\u001b[52X\n#[extra-testing]\u001b[47;2HInclude = /etc/pacman.d/mirrorlist\r\n\u001b[35X\n[extra]\r\nInclude = /etc/pacman.d/mirrorlist\r\n\u001b[35X\n# If you want to run 32 bit applications on your x86_64 system,\u001b[53;3Henable the multilib repositories as required here.\u001b[20X\r\n\u001b[41X\u001b[55;3Hmultilib-testing]\u001b[56;2HInclude = /etc/pacman.d/mirrorlist\r\n\u001b[33X\n#[multilib]\u001b[K\r\n#Include = /etc/pacman.d/mirrorlist\r\n\u001b[K\n# An example of a custom package repository.  See the pacman manpage for\u001b[K\r\n# tips on creating your own repositories.\u001b[K\r\n#[custom]\u001b[K\r\n#SigLevel = Optional TrustAll\u001b[K\r\nrServer = file:///home/custompkgs\u001b[K\r\n\u001b[0;10;7m\u000fetc/pacman.conf [+]                                                                                                                                                                                                           100,7          Bot\u001b[2 q\u001b[?1002h\u001b[?1006h\u001b[65;7H\u001b[?25h"]
