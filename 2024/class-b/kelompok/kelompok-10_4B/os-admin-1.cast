[0.020, "o", "(519/520) installing libhx                                                                                   [################################################################] 100%\r\r\n(520/520) installing pam_mount                                                                               [----------------------------------------------------------------]   0%\r(520/520) installing pam_mount                                                                               [################################################################] 100%\r\r\n"]
