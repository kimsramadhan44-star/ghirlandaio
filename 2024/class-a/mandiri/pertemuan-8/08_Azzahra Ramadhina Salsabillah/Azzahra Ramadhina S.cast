[0.251, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H#    HOOKS=(base udev microcode modconf block lvm2 filesystems fsck)\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f8,2            5\u001b[46;2H\u001b[?25h"]
