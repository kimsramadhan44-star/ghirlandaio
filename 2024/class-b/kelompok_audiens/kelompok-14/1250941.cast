[0.000, "o", "\u001b[?25l\u001b[0;10;1m\u000fDefaults\u001b[m\u000f \u001b[94msecure_path\u001b[m\u000f=\u001b[92m\"/usr/local/sbin:/usr/local/bin:/usr/bin\"\u001b[m\u000f\u001b[K\r\n##\u001b[K\r\n## You may wish to keep some of the following environment variables\u001b[K\r\n## when running commands via sudo.\u001b[K\r\n##\u001b[K\r\n## Locale settings\u001b[K\r\n# Defaults env_keep += \"LANG LANGUAGE LINGUAS LC_* _XKB_CHARSET\"\u001b[K\r\n##\u001b[K\r\n## Run X applications through sudo; HOME is used to find the\u001b[K\r\n## .Xauthority file.  Note that other programs use HOME to find   \u001b[K\r\n## configuration files and this may lead to privilege escalation!\u001b[K\r\n# Defaults env_keep += \"HOME\"\u001b[K\r\n##\u001b[K\r\n## X11 resource path settings\u001b[K\r\n# Defaults env_keep += \"XAPPLRESDIR XFILESEARCHPATH XUSERFILESEARCHPATH\"\u001b[K\r\n##\u001b[K\r\n## Desktop path settings\u001b[K\r\n# Defaults env_keep += \"QTDIR KDEDIR\"\u001b[K\r\n##\u001b[K\r\n## Allow sudo-run commands to inherit the callers' ConsoleKit session\u001b[K\r\n# Defaults env_keep += \"XDG_SESSION_COOKIE\"\u001b[K\r\n##\u001b[K\r\n## Uncomment to enable special input methods.  Care should be taken as\u001b[K\r\n## this may allow users to subvert the command being run via sudo.\u001b[K\r\n# Defaults env_keep += \"XMODIFIERS GTK_IM_MODULE QT_IM_MODULE QT_IM_SWITCHER\"\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable \"use_pty\" when running commands as root.\u001b[K\r\n## Commands run as non-root users will run in a pseudo-terminal,\u001b[K\r\n## not the user's own terminal, to prevent command injection.\u001b[K\r\n# Defaults>root !use_pty\u001b[K\r\n##\u001b[K\r\n## Uncomment to run commands in the background by default.\u001b[K\r\n## This can be used to prevent sudo from consuming user input while\u001b[K\r\n## a non-interactive command runs if \"use_pty\" or I/O logging are\u001b[K\r\n## enabled.  Some commands may not run properly in the background.\u001b[K\r\n# Defaults exec_background\u001b[K\r\n##\u001b[K\r\n## Uncomment to send mail if the user does not enter the correct password.\u001b[K\r\n# Defaults mail_badpass\u001b[K\r\n##\u001b[K\r\n## Uncomment to enable logging of a command's output, except for\u001b[K\r\n## sudoreplay and reboot.  Use sudoreplay to play back logged sessions.\u001b[K\r\n## Sudo will create up to 2,176,782,336 I/O logs before recycling them.\u001b[K\r\n## Set maxseq to a smaller number if you don't have unlimited disk space.\u001b[K\r\n# Defaults log_output\u001b[K\r\n# Defaults!/usr/bin/sudoreplay !log_output\u001b[K\r\n# Defaults!/usr/local/bin/sudoreplay !log_output\u001b[K\r\n# Defaults!REBOOT !log_output\u001b[K\r\n# Defaults maxseq = 1000\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable intercept and log_subcmds for debuggers and\u001b[K\r\n## tracers.  Otherwise, anything that uses ptrace(2) will be unable\u001b[K\r\n## to run under sudo if intercept_type is set to \"trace\".\u001b[K\r\n# Defaults!DEBUGGERS !intercept, !log_subcmds\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable intercept and log_subcmds for package managers.\u001b[K\r\n## Some package scripts run a huge number of commands, which is made\u001b[K\r\n## slower by these options and also can clutter up the logs.\u001b[K\r\n# Defaults!PKGMAN !intercept, !log_subcmds\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable PAM silent mode.  Otherwise messages by PAM\u001b[K\r\n## modules such as pam_faillock will not be printed.\u001b[K\r\n# Defaults !pam_silent\u001b[K\r\n\u001b[K\n##\u001b[K\r\n## Runas alias specification\u001b[K\r\n##\u001b[K\r\n\u001b[K\n##\u001b[K\r\n## User privilege specification\u001b[K\r\n##\u001b[K\r\n\u001b[92mroot\u001b[m\u000f \u001b[96mALL\u001b[m\u000f=(\u001b[96mALL\u001b[m\u000f:\u001b[96mALL\u001b[m\u000f) \u001b[96mALL\u001b[m\u000f\u001b[K\r\nfauzanALL=(ALL:ALL) ALL\u001b[K\r\n\u001b[0;10;7m\u000fetc/sudoers.tmp                                                                                                                                                                                                               123,1          75%\u001b[m\u000f\r\n\u001b[J\u001b[2 q\u001b[2 q\u001b[H\u001b[0;10;1m\u000fDefaults\u001b[m\u000f \u001b[94msecure_path\u001b[m\u000f=\u001b[92m\"/usr/local/sbin:/usr/local/bin:/usr/bin\"\u001b[m\u000f\u001b[K\r\n##\u001b[K\r\n## You may wish to keep some of the following environment variables\u001b[K\r\n## when running commands via sudo.\u001b[K\r\n##\u001b[K\r\n## Locale settings\u001b[K\r\n# Defaults env_keep += \"LANG LANGUAGE LINGUAS LC_* _XKB_CHARSET\"\u001b[K\r\n##\u001b[K\r\n## Run X applications through sudo; HOME is used to find the\u001b[K\r\n## .Xauthority file.  Note that other programs use HOME to find   \u001b[K\r\n## configuration files and this may lead to privilege escalation!\u001b[K\r\n# Defaults env_keep += \"HOME\"\u001b[K\r\n##\u001b[K\r\n## X11 resource path settings\u001b[K\r\n# Defaults env_keep += \"XAPP"]
[0.003, "o", "LRESDIR XFILESEARCHPATH XUSERFILESEARCHPATH\"\u001b[K\r\n##\u001b[K\r\n## Desktop path settings\u001b[K\r\n# Defaults env_keep += \"QTDIR KDEDIR\"\u001b[K\r\n##\u001b[K\r\n## Allow sudo-run commands to inherit the callers' ConsoleKit session\u001b[K\r\n# Defaults env_keep += \"XDG_SESSION_COOKIE\"\u001b[K\r\n##\u001b[K\r\n## Uncomment to enable special input methods.  Care should be taken as\u001b[K\r\n## this may allow users to subvert the command being run via sudo.\u001b[K\r\n# Defaults env_keep += \"XMODIFIERS GTK_IM_MODULE QT_IM_MODULE QT_IM_SWITCHER\"\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable \"use_pty\" when running commands as root.\u001b[K\r\n## Commands run as non-root users will run in a pseudo-terminal,\u001b[K\r\n## not the user's own terminal, to prevent command injection.\u001b[K\r\n# Defaults>root !use_pty\u001b[K\r\n##\u001b[K\r\n## Uncomment to run commands in the background by default.\u001b[K\r\n## This can be used to prevent sudo from consuming user input while\u001b[K\r\n## a non-interactive command runs if \"use_pty\" or I/O logging are\u001b[K\r\n## enabled.  Some commands may not run properly in the background.\u001b[K\r\n# Defaults exec_background\u001b[K\r\n##\u001b[K\r\n## Uncomment to send mail if the user does not enter the correct password.\u001b[K\r\n# Defaults mail_badpass\u001b[K\r\n##\u001b[K\r\n## Uncomment to enable logging of a command's output, except for\u001b[K\r\n## sudoreplay and reboot.  Use sudoreplay to play back logged sessions.\u001b[K\r\n## Sudo will create up to 2,176,782,336 I/O logs before recycling them.\u001b[K\r\n## Set maxseq to a smaller number if you don't have unlimited disk space.\u001b[K\r\n# Defaults log_output\u001b[K\r\n# Defaults!/usr/bin/sudoreplay !log_output\u001b[K\r\n# Defaults!/usr/local/bin/sudoreplay !log_output\u001b[K\r\n# Defaults!REBOOT !log_output\u001b[K\r\n# Defaults maxseq = 1000\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable intercept and log_subcmds for debuggers and\u001b[K\r\n## tracers.  Otherwise, anything that uses ptrace(2) will be unable\u001b[K\r\n## to run under sudo if intercept_type is set to \"trace\".\u001b[K\r\n# Defaults!DEBUGGERS !intercept, !log_subcmds\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable intercept and log_subcmds for package managers.\u001b[K\r\n## Some package scripts run a huge number of commands, which is made\u001b[K\r\n## slower by these options and also can clutter up the logs.\u001b[K\r\n# Defaults!PKGMAN !intercept, !log_subcmds\u001b[K\r\n##\u001b[K\r\n## Uncomment to disable PAM silent mode.  Otherwise messages by PAM\u001b[K\r\n## modules such as pam_faillock will not be printed.\u001b[K\r\n# Defaults !pam_silent\u001b[K\r\n\u001b[K\n##\u001b[K\r\n## Runas alias specification\u001b[K\r\n##\u001b[K\r\n\u001b[K\n##\u001b[K\r\n## User privilege specification\u001b[K\r\n##\u001b[K\r\n\u001b[92mroot\u001b[m\u000f \u001b[96mALL\u001b[m\u000f=(\u001b[96mALL\u001b[m\u000f:\u001b[96mALL\u001b[m\u000f) \u001b[96mALL\u001b[m\u000f\u001b[K\r\nfauzanALL=(ALL:ALL) ALL\u001b[K\r\n\u001b[0;10;7m\u000fetc/sudoers.tmp                                                                                                                                                                                                               123,1          75%\u001b[m\u000f\r\n\u001b[J\u001b[A\u001b[A\u001b[?25h\u001bP+q4D73\u001b\\"]
