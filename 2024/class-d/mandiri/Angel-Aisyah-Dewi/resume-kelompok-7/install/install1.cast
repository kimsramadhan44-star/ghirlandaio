[0.000, "o", "\r\u001b[K                               Available networks\u001b[1;90m                             *\u001b[0m\r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K\u001b[90m--------------------------------------------------------------------------------\r\n\u001b[0m\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K\u001b[1;90m      Network name                      Security            Signal\r\n\u001b[0m\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K\u001b[90m--------------------------------------------------------------------------------\r\n\u001b[0m\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K  \u001b[1;90m> \u001b[0m  PUTRIBIN                          psk                 ****    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      fras                              psk                 **\u001b[1;90m**\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      ENIN                              psk                 *\u001b[1;90m***\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      Pikko81                           psk                 *\u001b[1;90m***\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      HARDJUNO                          psk                 *\u001b[1;90m***\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      shmbg                             psk                 *\u001b[1;90m***\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K      SatriyosMesh                      psk                 *\u001b[1;90m***\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K\r\n\u001b[32m[iwd]\u001b[0m# exi\r\u001b[K\u0001\u001b[32m\u0002[iwd]\u0001\u001b[0m\u0002# station wlan0 connect PUTRIBIN \r\nType the network passphrase for PUTRIBIN psk.\r\n\u001b[94mPassphrase: \u001b[0m*********\r\n\u001b[32m[iwd]\u001b[0m# exi"]
