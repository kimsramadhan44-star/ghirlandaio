[0.003, "o", "\u001b[1;65r\u001b[H\u001b[35M\u001b[1;67r\u001b[1;7H\u001b[30m\u001b[103ms\u001b[m\u000fePkgLi\u001b[30m\u001b[103ms\u001b[m\u000ft\u001b[30m\u001b[103ms\ns\u001b[3;10Hs\u001b[4;4Hs\u001b[m\u000fableSandboxFile\u001b[30m\u001b[103ms\u001b[m\u000fy\u001b[30m\u001b[103ms\u001b[5;4Hs\u001b[m\u000fableSandboxSy\u001b[30m\u001b[103ms\u001b[m\u000fcall\u001b[30m\u001b[103ms\u001b[7;28Hs\u001b[m\u000f package\u001b[30m\u001b[103ms\u001b[m\u000f \u001b[30m\u001b[103ms\u001b[m\u000figned by key\u001b[30m\u001b[103ms\u001b[m\u000f that it\u001b[30m\u001b[103ms\u001b[8;6Hs\u001b[m\u000ft\u001b[30m\u001b[103ms\u001b[m\u000f (\u001b[30m\u001b[103ms\u001b[m\u000fee pacman-key and it\u001b[30m\u001b[103ms\u001b[m\u000f man page), a\u001b[30m\u001b[103ms\u001b[m\u000f well a\u001b[30m\u001b[103ms\u001b[m\u000f un\u001b[30m\u001b[103ms\u001b[m\u000figned package\u001b[30m\u001b[103ms\u001b[9;30Hs\u001b[13;15Hs\u001b[m\u000ft run `pacman-key --init` before fir\u001b[30m\u001b[103ms\u001b[m\u000ft u\u001b[30m\u001b[103ms\u001b[m\u000fi\u001b[14;45H\u001b[30m\u001b[103ms\u001b[15;11Hs\u001b[20;19Hs\u001b[m\u000fearch repo\u001b[30m\u001b[103ms\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[21;15Hs\u001b[m\u000ftom mirror\u001b[30m\u001b[103ms\u001b[m\u000f can be added here or in \u001b[30m\u001b[103ms\u001b[m\u000feparate file\u001b[30m\u001b[103ms\u001b[22;12H\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[m\u000f li\u001b[30m\u001b[103ms\u001b[m\u000fted fir\u001b[30m\u001b[103ms\u001b[m\u000ft will take precedence when package\u001b[30m\u001b[103ms\u001b[23;26Hs\u001b[m\u000f, regardle\u001b[30m\u001b[103mss\u001b[m\u000f of ver\u001b[30m\u001b[103ms\u001b[m\u000fi\u001b[24;10H\u001b[30m\u001b[103ms\u001b[25;10Hs\u001b[27;8H\u001b[m\u000fitory entrie\u001b[30m\u001b[103ms\r\n\n\n\n\u001b[m\u000f#\u001b[K\r\n# The header [repo-name] i\u001b[30m\u001b[103ms\u001b[m\u000f crucial - it mu\u001b[30m\u001b[103ms\u001b[m\u000ft be pre\u001b[30m\u001b[103ms\u001b[m\u000fent and\u001b[K\r\n# uncommented to enable the repo.\u001b[K\r\n#\u001b[K\r\n\u001b[K\n# The te\u001b[30m\u001b[103ms\u001b[m\u000fting repo\u001b[30m\u001b[103ms\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[m\u000f are di\u001b[30m\u001b[103ms\u001b[m\u000fabled by default. To enable, uncomment the\u001b[K\r\n# repo name header and Include line\u001b[30m\u001b[103ms\u001b[m\u000f. You can add preferred \u001b[30m\u001b[103ms\u001b[m\u000ferver\u001b[30m\u001b[103ms\u001b[m\u000f immediately\u001b[K\r\n# after the header, and they will be u\u001b[30m\u001b[103ms\u001b[m\u000fed before the default mirror\u001b[30m\u001b[103ms\u001b[m\u000f.\u001b[K\r\n\u001b[K\n#[core-te\u001b[30m\u001b[103ms\u001b[m\u000fting]\u001b[K\r\n#Include = /etc/pacman.d/mirrorli\u001b[30m\u001b[103ms\u001b[m\u000ft\u001b[K\r\n\u001b[K\n[core]\u001b[K\r\nInclude = /etc/pacman.d/mirrorli\u001b[30m\u001b[103ms\u001b[m\u000ft\u001b[K\r\n\u001b[K\n#[extra-te\u001b[30m\u001b[103ms\u001b[m\u000fting]\u001b[K\r\n#Include = /etc/pacman.d/mirrorli\u001b[30m\u001b[103ms\u001b[m\u000ft\u001b[K\r\n\u001b[K\n[extra]\u001b[K\r\nInclude = /etc/pacman.d/mirrorli\u001b[30m\u001b[103ms\u001b[m\u000ft\u001b[K\r\n\u001b[K\n# If you want to run 32 bit application\u001b[30m\u001b[103ms\u001b[m\u000f on your x86_64 \u001b[30m\u001b[103ms\u001b[m\u000fy\u001b[30m\u001b[103ms\u001b[m\u000ftem,\u001b[K\r\n# enable the multilib repo\u001b[30m\u001b[103ms\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[m\u000f a\u001b[30m\u001b[103ms\u001b[m\u000f required here.\u001b[K\r\n\u001b[K\n#[multilib-te\u001b[30m\u001b[103ms\u001b[m\u000fting]\u001b[K\r\n#Include = /etc/pacman.d/mirrorli\u001b[30m\u001b[103ms\u001b[m\u000ft\u001b[K\r\n\u001b[K\n#[multilib]\u001b[K\r\n#Include = /etc/pacman.d/mirrorli\u001b[30m\u001b[103ms\u001b[m\u000ft\u001b[K\r\n\u001b[K\n# An example of a cu\u001b[30m\u001b[103ms\u001b[m\u000ftom package repo\u001b[30m\u001b[103ms\u001b[m\u000fitory.  See the pacman manpage for\u001b[K\r\n# tip\u001b[30m\u001b[103ms\u001b[m\u000f on creating your own repo\u001b[30m\u001b[103ms\u001b[m\u000fitorie\u001b[30m\u001b[103ms\u001b[m\u000f.\u001b[K\r\n#[cu\u001b[30m\u001b[103ms\u001b[m\u000ftom]\u001b[K\r\n#SigLevel = Optional Tru\u001b[30m\u001b[103ms\u001b[m\u000ftAll\u001b[K\r\n#Server = file:///home/cu\u001b[30m\u001b[103ms\u001b[m\u000ftompkg\u001b[30m\u001b[103ms\u001b[m\u000f\u001b[K\u001b[66;223H\u001b[0;10;7m\u000f100,26         Bot\u001b[67;3H\u001b[?25h"]
[0.217, "o", "\u001b[?25l\b\u001b[m\u000f \u001b[1;7HsePkgLists\ns\u001b[3;10Hs\u001b[4;4HsableSandboxFilesys\u001b[5;4HsableSandboxSyscalls\u001b[7;28Hs packages signed by keys that its\u001b[8;6Hsts (see pacman-key and its man page), as well as unsigned packages\u001b[9;30Hs\u001b[13;15Hst run `pacman-key --init` before first us\u001b[14;45Hs\u001b[15;11Hs\u001b[20;19Hsearch repositories\u001b[21;15Hstom mirrors can be added here or in separate files\u001b[22;11Hsitories listed first will take precedence when packages\u001b[23;26Hs, regardless of vers\u001b[24;10Hs\u001b[25;10Hs\u001b[27;7Hsitory entries\u001b[32;27Hs crucial - it must be pres\u001b[36;9Hsting repositories are dis\u001b[37;36Hs. You can add preferred servers\u001b[38;39Hsed before the default mirrors\u001b[40;10Hs\u001b[41;34Hs\u001b[44;33Hs\u001b[46;11Hs\u001b[47;34Hs\u001b[50;33Hs\u001b[52;40Hs on your x86_64 sys\u001b[53;27Hsitories as\u001b[55;14Hs\u001b[56;34Hs\u001b[59;34Hs\u001b[61;21Hstom package repos\u001b[62;6Hs on creating your own repositories\u001b[63;5Hs\u001b[64;25Hs\nstompkgs\u001b[66;227H\u001b[0;10;7m\u000f1 \u001b[67;2H\u001b[?25h"]
