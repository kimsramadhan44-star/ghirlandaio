[0.003, "o", "Optional dependencies for firefox\r\n\u001b[0;1m   \u001b[0m hunspell-en_US: Spell checking, American English\r\n    libnotify: Notification integration\r\n    networkmanager: Location detection via available WiFi networks\r\n"]
[0.000, "o", "    onnxruntime: Local machine learning features such as smart tab groups\r\n"]
[0.002, "o", "    speech-dispatcher: Text-to-Speech\r\n    xdg-desktop-portal: Screensharing with Wayland\r\n(172/179) installing python-dbus                                                                       [------------------------------------------------------------]   0%\r"]
