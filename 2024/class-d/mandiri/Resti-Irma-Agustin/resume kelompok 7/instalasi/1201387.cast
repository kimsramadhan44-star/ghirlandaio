[3.490, "o", "\u001b[?2004l\u001b[K\r\r\n"]
[0.024, "o", "==> Creating install root at /mnt\r\n"]
[0.027, "o", "==> Installing packages to /mnt\r\n"]
[0.010, "o", "\u001b[?25l\u001b[1;34m::\u001b[0;1m Synchronizing package databases...\r\n\u001b[0m core\r\n"]
[0.001, "o", " extra\r\n"]
[1.646, "o", "\u001b[2F core is up to date\u001b[K"]
[1.002, "o", "\u001b[1E extra is up to date\u001b[K"]
[0.643, "o", "\u001b[1E"]
[0.170, "o", "resolving dependencies...\r\n"]
[0.015, "o", "\u001b[1;34m::\u001b[0;1m There are 3 providers available for oci-runtime:\r\n\u001b[0m\u001b[1;34m::\u001b[0;1m Repository \u001b[1;35mextra\r\n\u001b[0m\u001b[0;1m  \u001b[0m 1) crun  2) krun  3) runc\r\n\r\nEnter a number (default=1): \r\n"]
[0.008, "o", "\u001b[1;34m::\u001b[0;1m There are 2 providers available for jack:\r\n\u001b[0m\u001b[1;34m::\u001b[0;1m Repository \u001b[1;35mextra\r\n\u001b[0m\u001b[0;1m  \u001b[0m 1) jack2  2) pipewire-jack\r\n\r\nEnter a number (default=1): \r\n"]
[0.020, "o", "looking for conflicting packages...\r\n"]
