[0.005, "o", "Optional dependencies for systemd\r\n\u001b[0;1m   \u001b[0m libmicrohttpd: systemd-journal-gatewayd and systemd-journal-remote\r\n    apparmor: additional security features\r\n    quota-tools: kernel-level quota management\r\n    systemd-sysvcompat: symlink package to provide sysvinit binaries [pending]\r\n    systemd-ukify: combine kernel and initrd into a signed Unified Kernel Image\r\n    polkit: allow administration as unprivileged user\r\n    curl: systemd-journal-upload, machinectl pull-tar and pull-raw [installed]\r\n"]
[0.000, "o", "    gnutls: systemd-journal-gatewayd and systemd-journal-remote [installed]\r\n"]
