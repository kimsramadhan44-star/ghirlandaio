[0.001, "o", "\r\u001b[K                               Available networks\u001b[1;90m                              \u001b[0m\r\n\u001b[32m[iwd]\u001b[0m# \r\u001b[K\u001b[90m--------------------------------------------------------------------------------\r\n\u001b[0m\u001b[32m[iwd]\u001b[0m# \r\u001b[K\u001b[1;90m      Network name                      Security            Signal\r\n\u001b[0m\u001b[32m[iwd]\u001b[0m# \r\u001b[K\u001b[90m--------------------------------------------------------------------------------\r\n\u001b[0m\u001b[32m[iwd]\u001b[0m# \r\u001b[K  \u001b[1;90m> \u001b[0m  rogerlab                          psk                 ****    \r\n\u001b[32m[iwd]\u001b[0m# \r\u001b[K      intern                            psk                 **\u001b[1;90m**\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# \r\u001b[K      oooal                             psk                 ***\u001b[1;90m*\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# \r\u001b[K      bach                              psk                 **\u001b[1;90m**\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# \r\u001b[K      115 muhamad                       psk                 *\u001b[1;90m***\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# \r\u001b[K      Aisha                             psk                 *\u001b[1;90m***\u001b[0m    \r\n\u001b[32m[iwd]\u001b[0m# \r\u001b[K\r\n\u001b[32m[iwd]\u001b[0m# \r\u001b[K\u0001\u001b[32m\u0002[iwd]\u0001\u001b[0m\u0002# station wlan2 scan \r\n\u0001\u001b[32m\u0002[iwd]\u0001\u001b[0m\u0002# station wlan2 scan \r\n\u0001\u001b[32m\u0002[iwd]\u0001\u001b[0m\u0002# station wlan2 connect rogerlab \r\n\u0001\u001b[32m\u0002[iwd]\u0001\u001b[0m\u0002# station wlan2 scan \r\n\u001b[0;91mOperation already in progress\r\n\u001b[0m\u001b[0;91mOperation failed\r\n\u001b[0m\u0001\u001b[32m\u0002[iwd]\u0001\u001b[0m\u0002# station wlan2 connect rogerlab \r\nType the network passphrase for rogerlab psk.\r\n\u001b[94mPassphrase: \u001b[0m***************\r\n\u0001\u001b[32m\u0002[iwd]\u0001\