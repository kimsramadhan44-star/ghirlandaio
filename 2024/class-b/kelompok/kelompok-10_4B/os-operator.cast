[0.043, "o", "\r\n:: The firewallD components & utilities have now been split into different packages:\r\n\r\n   - firewalld: Firewall daemon with D-Bus interface \r\n   - python-firewall: Python bindings for firewallD\r\n   - firewall-config: Graphical user interface for firewallD\r\n   - firewall-applet: Systray applet for firewallD\r\n   - firewalld-test: FirewallD test suite\r\n\r\n   Make sure to install the ones you may want / need.\r\n\r\n"]
[0.010, "o", "Optional dependencies for firewalld\r\n\u001b[0;1m   \u001b[0m bash-completion: bash completion\r\n    networkmanager: NetworkManager support\r\n    polkit: privileged actions\r\n    firewall-config: Graphical user interface for firewallD configuration\r\n    firewall-applet: Systray applet for firewallD\r\n    firewalld-test: firewallD test suite\r\n(187/191) installing which                                                                                                                       [----------------------------------------------------------------------------------------]   0%\r(187/191) installing which                                                                                                                       [########################################################################################] 100%\r\r\n(188/191) installing libtool                                                                                                                     [----------------------------------------------------------------------------------------]   0%\r"]
[0.000, "o", "(188/191) installing libtool                                                                                                                     [########################################################################################] 100%\r\r\n"]
[0.007, "o", "(189/191) installing runc                                                                                                                        [----------------------------------------------------------------------------------------]   0%\r"]
[0.013, "o", "(189/191) installing runc                                                                                                                        [########################################################################################] 100%\r\r\n"]
[0.001, "o", "Optional dependencies for runc\r\n\u001b[0;1m   \u001b[0m criu: checkpoint support\r\n"]
