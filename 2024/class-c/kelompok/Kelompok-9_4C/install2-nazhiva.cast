[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# COMPRESSION_OPTIONS\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f9,2           65\u001b[46;2H\u001b[?25h"]
[0.032, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# Additional options for the compressor\u001b[K\u001b[47;153H\u001b[0;10;7m\u000f70,2           68\u001b[46;2H\u001b[?25h"]
[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H#COMPRESSION_OPTIONS=()\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f1,2           71\u001b[46;2H\u001b[?25h"]
[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f2,1           74\r\u001b[A\u001b[?25h"]
[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# MODULES_DECOMPRESS\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f3,2           77\u001b[46;2H\u001b[?25h"]
[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# Decompress loadable kernel modules and their firmware during initramfs\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f4,2           80\u001b[46;2H\u001b[?25h"]
[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# creation. Switch (yes/no).\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f5,2           82\u001b[46;2H\u001b[?25h"]
[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# Enable to allow further decreasing image size when using high compression\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f6,2           85\u001b[46;2H\u001b[?25h"]
[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# (e.g. xz -9e or zstd --long --ultra -22) at the expense of increased RAM usage\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f7,2           88\u001b[46;2H\u001b[?25h"]
[0.032, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# at early boot.\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f8,2           91\u001b[46;2H\u001b[?25h"]
[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# Note that any compressed files will be placed in the uncompressed early CPIO\u001b[K\u001b[47;154H\u001b[0;10;7m\u000f9,2           94\u001b[46;2H\u001b[?25h"]
[0.033, "o", "\u001b[?25l\u001b[1;46r\u001b[H\u001b[m\u000f\u001b[M\u001b[1;48r\u001b[46;1H# to avoid double compression.\u001b[K\u001b[47;153H\u001b[0;10;7m\u000f80,2           97\u001b[46;2H\u001b[?25h"]
