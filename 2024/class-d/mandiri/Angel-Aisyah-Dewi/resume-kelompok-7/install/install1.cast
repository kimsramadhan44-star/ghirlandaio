[0.000, "o", "\u001b[?25l\u001b[m\u000f#\u001b[K\r\n# /etc/pacman.conf\u001b[K\r\n#\u001b[K\r\n# See the pacman.conf(5) manpage for option and repository directives\u001b[K\r\n\u001b[K\n#\u001b[K\r\n# GENERAL OPTIONS\u001b[K\r\n#\u001b[K\r\n[options]\u001b[K\r\n# The following paths are commented out with their default values listed.\u001b[K\r\n# If you wish to use different paths, uncomment and update the paths.\u001b[K\r\n#RootDir     = /\u001b[K\r\n#DBPath      = /var/lib/pacman/\u001b[K\r\n#CacheDir    = /var/cache/pacman/pkg/\u001b[K\r\n#LogFile     = /var/log/pacman.log\u001b[K\r\n#GPGDir      = /etc/pacman.d/gnupg/\u001b[K\r\n#HookDir     = /etc/pacman.d/hooks/\u001b[K\r\nHoldPkg     = pacman glibc\u001b[K\r\n#XferCommand = /usr/bin/curl -L -C - -f -o %o %u\u001b[K\r\n#XferCommand = /usr/bin/wget --passive-ftp -c -O %o %u\u001b[K\r\n#CleanMethod = KeepInstalled\u001b[K\r\nArchitecture = auto\u001b[K\r\n\u001b[K\n# Pacman won't upgrade packages listed in IgnorePkg and members of IgnoreGroup\u001b[K\r\n#IgnorePkg   =\u001b[K\r\n#IgnoreGroup =\u001b[K\r\n\u001b[K\n#NoUpgrade   =\u001b[K\r\n#NoExtract   =\u001b[K\r\n\u001b[K\n# Misc options\u001b[K\r\n#UseSyslog\u001b[K\r\n#Color\u001b[K\r\n#NoProgressBar\u001b[K\r\nCheckSpace\u001b[K\r\n#VerbosePkgLists\u001b[K\r\nParallelDownloads = 5\u001b[K\r\nDownloadUser = alpm\u001b[K\r\n#DisableSandboxFilesystem\u001b[K\r\n#DisableSandboxSyscalls\u001b[K\r\n\u001b[K\n# By default, pacman accepts packages signed by keys that its local keyring\u001b[K\r\n# trusts (see pacman-key and its man page), as well as unsigned packages.\u001b[K\r\nSigLevel    = Required DatabaseOptional\u001b[K\r\nLocalFileSigLevel = Optional\u001b[K\r\n#RemoteFileSigLevel = Required\u001b[K\r\n\u001b[K\n# NOTE: You must run `pacman-key --init` before first using pacman; the local\u001b[K\r\n# keyring can then be populated with the keys of all official Arch Linux\u001b[K\r\n# packagers with `pacman-key --populate archlinux`.\u001b[K\r\n\u001b[K\n#\u001b[K\r\n# REPOSITORIES\u001b[K\r\n#   - can be defined here or included from another file\u001b[K\r\n#   - pacman will search repositories in the order defined here\u001b[K\r\n#   - local/custom mirrors can be added here or in separate files\u001b[K\r\n#   - repositories listed first will take precedence when packages\u001b[K\r\n#     have identical names, regardless of version number\u001b[K\r\n#   - URLs will have $repo replaced by the name of the current repo\u001b[K\r\n#   - URLs will have $arch replaced by the name of the architecture\u001b[K\r\n#\u001b[K\r\n# Repository entries are of the format:\u001b[K\r\n#       [repo-name]\u001b[K\r\n#       Server = ServerName\u001b[K\r\n#       Include = IncludePath\u001b[K\r\n\u001b[0;10;7m\u000fetc/pacman.conf                                                                                                                                                                                                               1,1            Top\u001b[m\u000f\r\n\u001b[J\u001b[2 q\u001b[2 q\u001b[H#\u001b[K\r\n# /etc/pacman.conf\u001b[K\r\n#\u001b[K\r\n# See the pacman.conf(5) manpage for option and repository directives\u001b[K\r\n\u001b[K\n#\u001b[K\r\n# GENERAL OPTIONS\u001b[K\r\n#\u001b[K\r\n[options]\u001b[K\r\n# The following paths are commented out with their default values listed.\u001b[K\r\n# If you wish to use different paths, uncomment and update the paths.\u001b[K\r\n#RootDir     = /\u001b[K\r\n#DBPath      = /var/lib/pacman/\u001b[K\r\n#CacheDir    = /var/cache/pacman/pkg/\u001b[K\r\n#LogFile     = /var/log/pacman.log\u001b[K\r\n#GPGDir      = /etc/pacman.d/gnupg/\u001b[K\r\n#HookDir     = /etc/pacman.d/hooks/\u001b[K\r\nHoldPkg     = pacman glibc\u001b[K\r\n#XferCommand = /usr/bin/curl -L -C - -f -o %o %u\u001b[K\r\n#XferCommand = /usr/bin/wget --passive-ftp -c -O %o %u\u001b[K\r\n#CleanMethod = KeepInstalled\u001b[K\r\nArchitecture = auto\u001b[K\r\n\u001b[K\n# Pacman won't upgrade packages listed in IgnorePkg and members of IgnoreGroup\u001b[K\r\n#IgnorePkg   =\u001b[K\r\n#IgnoreGroup =\u001b[K\r\n\u001b[K\n#NoUpgrade   =\u001b[K\r\n#NoExtract   =\u001b[K\r\n\u001b[K\n# Misc options\u001b[K\r\n#UseSyslog\u001b[K\r\n#Color\u001b[K\r\n#NoProgressBar\u001b[K\r\nCheckSpace\u001b[K\r\n#VerbosePkgLists\u001b[K\r\nParallelDownloads = 5\u001b[K\r\nDownloadUser = alpm\u001b[K\r\n#DisableSandboxFilesystem\u001b[K\r\n#DisableSandboxSyscalls\u001b[K\r\n\u001b[K\n# By default, pacman accepts packages signed by keys that its local keyring\u001b[K\r\n# trusts (see pacman-key and its man page), as well as unsigned packages.\u001b[K\r\nSigLevel    = Required DatabaseOptional\u001b[K\r\nLocalFileSigLevel = Optional\u001b[K\r\n#RemoteFileSigLevel = Required\u001b[K\r\n\u001b[K\n# NOTE: You must run `pacman-key --init` before first using pacman; the local\u001b[K\r\n# keyring can then be populated with the keys of all official Arch Linux\u001b[K\r\n# packagers with `pa"]
[0.000, "o", "cman-key --populate archlinux`.\u001b[K\r\n\u001b[K\n#\u001b[K\r\n# REPOSITORIES\u001b[K\r\n#   - can be defined here or included from another file\u001b[K\r\n#   - pacman will search repositories in the order defined here\u001b[K\r\n#   - local/custom mirrors can be added here or in separate files\u001b[K\r\n#   - repositories listed first will take precedence when packages\u001b[K\r\n#     have identical names, regardless of version number\u001b[K\r\n#   - URLs will have $repo replaced by the name of the current repo\u001b[K\r\n#   - URLs will have $arch replaced by the name of the architecture\u001b[K\r\n#\u001b[K\r\n# Repository entries are of the format:\u001b[K\r\n#       [repo-name]\u001b[K\r\n#       Server = ServerName\u001b[K\r\n#       Include = IncludePath\u001b[K\r\n\u001b[0;10;7m\u000fetc/pacman.conf                                                                                                                                                                                                               1,1            Top\u001b[m\u000f\r\n\u001b[J\u001b[H\u001b[?25h\u001bP+q4D73\u001b\\"]
